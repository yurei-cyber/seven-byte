---
import { sevenByte } from '../config/site';
import { path as p } from '../config/paths';

const current = Astro.url.pathname;

const links = [
  { href: p('/'), label: 'ご案内', match: '/' },
  { href: p('/plan/'), label: '初期プラン', match: '/plan' },
  { href: p('/process/'), label: '進め方', match: '/process' },
  { href: p('/contact/'), label: 'お見積り', match: '/contact' },
  { href: p('/demo/'), label: 'デモサイト', match: '/demo' },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={p('/')}>Seven <span>Byte</span></a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      メニュー
    </button>
    <nav class="nav" id="primary-nav" data-nav aria-label="メイン">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              link.match === '/'
                ? current === p('/') || current === p('').replace(/\/$/, '') || current.endsWith('/seven-byte/') || current === '/'
                  ? 'page'
                  : undefined
                : current.includes(link.match)
                  ? 'page'
                  : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      {
        sevenByte.lineEnabled ? (
          <a class="btn btn-line" href={sevenByte.lineUrl} rel="noopener noreferrer" target="_blank">
            LINEで相談
          </a>
        ) : null
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
