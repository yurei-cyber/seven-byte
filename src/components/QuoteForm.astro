---
import { sevenByte } from '../config/site';

/**
 * Client validation + optional remote endpoint (Formspree etc.).
 * Static hosting has no first-party server validation; the remote endpoint
 * (when configured) provides server-side checks. Never report success unless
 * mailto opened with a real address or the endpoint returned OK.
 */
const endpoint = sevenByte.formEndpoint;
const mailto = sevenByte.email;
const mode = sevenByte.formMode;
---

<form
  class="form"
  id="quote-form"
  method="POST"
  action={mode === 'endpoint' ? endpoint : undefined}
  data-mode={mode}
  data-mailto={mailto || ''}
  novalidate
>
  {/* Honeypot — bots filling this are rejected client-side */}
  <div class="hp-field" aria-hidden="true">
    <label for="company_website">Website</label>
    <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for="business-name">店舗名・屋号 <span aria-hidden="true">*</span></label>
    <input
      id="business-name"
      name="businessName"
      type="text"
      required
      maxlength="80"
      autocomplete="organization"
      placeholder="例：○○自動車整備"
    />
    <span class="error" data-error-for="businessName" role="alert"></span>
  </div>

  <div class="field">
    <label for="business-type">業種 <span aria-hidden="true">*</span></label>
    <select id="business-type" name="businessType" required>
      <option value="">選択してください</option>
      <option value="整備工場">自動車整備工場</option>
      <option value="中古車販売">中古車販売</option>
      <option value="併設">整備と販売の併設</option>
      <option value="その他中小企業">その他の中小企業・サービス業</option>
    </select>
    <span class="error" data-error-for="businessType" role="alert"></span>
  </div>

  <div class="field">
    <label for="interest">ご興味のあるサービス <span aria-hidden="true">*</span></label>
    <select id="interest" name="interest" required>
      <option value="">選択してください</option>
      <option value="ホームページ制作">ホームページ制作</option>
      <option value="業務システム開発">業務システム開発</option>
      <option value="保守・運用">保守・運用サポート</option>
      <option value="相談のみ">まずは相談したい</option>
    </select>
    <span class="error" data-error-for="interest" role="alert"></span>
  </div>

  <div class="field">
    <label for="area">所在地（市町村） <span aria-hidden="true">*</span></label>
    <input
      id="area"
      name="area"
      type="text"
      required
      maxlength="40"
      placeholder="例：浜松市"
      list="area-suggestions"
    />
    <datalist id="area-suggestions">
      <option value="浜松市"></option>
      <option value="掛川市"></option>
      <option value="袋井市"></option>
    </datalist>
    <span class="error" data-error-for="area" role="alert"></span>
  </div>

  <div class="field">
    <label for="contact-name">ご担当者名 <span aria-hidden="true">*</span></label>
    <input id="contact-name" name="contactName" type="text" required maxlength="40" autocomplete="name" />
    <span class="error" data-error-for="contactName" role="alert"></span>
  </div>

  <div class="field">
    <label for="email">メールアドレス <span aria-hidden="true">*</span></label>
    <input
      id="email"
      name="email"
      type="email"
      required
      maxlength="120"
      autocomplete="email"
      placeholder="you@example.com"
    />
    <span class="error" data-error-for="email" role="alert"></span>
  </div>

  <div class="field">
    <label for="phone">電話番号（任意）</label>
    <input
      id="phone"
      name="phone"
      type="tel"
      maxlength="20"
      autocomplete="tel"
      inputmode="tel"
      placeholder="053-000-0000"
    />
    <span class="hint">半角数字とハイフンのみ。</span>
    <span class="error" data-error-for="phone" role="alert"></span>
  </div>

  <div class="field">
    <label for="message">ご要望・現状など <span aria-hidden="true">*</span></label>
    <textarea
      id="message"
      name="message"
      required
      maxlength="2000"
      placeholder="例：初めてホームページを作りたい。車検案内とアクセスを分かりやすくしたい。"
    ></textarea>
    <span class="error" data-error-for="message" role="alert"></span>
  </div>

  <p class="hint" style="margin:0">
    決済情報やマイナンバー等の機微情報は送信しないでください。
    {
      mode === 'endpoint'
        ? '送信先は設定済みのフォーム受付です。'
        : mailto
          ? '送信時にメール作成画面が開きます。メーラーでの送信完了が必要です。'
          : '現在、公開受付先の設定前のため、このフォームからは送信完了できません。'
    }
  </p>

  <button class="btn btn-primary" type="submit" id="quote-submit">無料で相談する</button>
  <p class="form-status" id="quote-status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('quote-status');
  const submitBtn = document.getElementById('quote-submit') as HTMLButtonElement | null;

  function setError(name: string, text: string) {
    const el = form?.querySelector(`[data-error-for="${name}"]`);
    if (el) el.textContent = text;
  }

  function clearErrors() {
    form?.querySelectorAll('[data-error-for]').forEach((el) => {
      el.textContent = '';
    });
  }

  function validate(): boolean {
    if (!form) return false;
    clearErrors();
    let ok = true;

    const honeypot = (form.elements.namedItem('company_website') as HTMLInputElement).value.trim();
    if (honeypot) {
      statusEl && ((statusEl.dataset.state = 'err'), (statusEl.textContent = '送信をブロックしました。'));
      return false;
    }

    const businessName = (form.elements.namedItem('businessName') as HTMLInputElement).value.trim();
    const businessType = (form.elements.namedItem('businessType') as HTMLSelectElement).value;
    const interest = (form.elements.namedItem('interest') as HTMLSelectElement).value;
    const area = (form.elements.namedItem('area') as HTMLInputElement).value.trim();
    const contactName = (form.elements.namedItem('contactName') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

    if (!businessName || businessName.length > 80) {
      setError('businessName', '店舗名を入力してください（80文字以内）。');
      ok = false;
    }
    if (!businessType) {
      setError('businessType', '業種を選択してください。');
      ok = false;
    }
    if (!interest) {
      setError('interest', 'ご興味のあるサービスを選択してください。');
      ok = false;
    }
    if (!area || area.length > 40) {
      setError('area', '所在地を入力してください。');
      ok = false;
    }
    if (!contactName || contactName.length > 40) {
      setError('contactName', 'ご担当者名を入力してください。');
      ok = false;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setError('email', '有効なメールアドレスを入力してください。');
      ok = false;
    }
    if (phone && !/^[0-9+\-() ]{8,20}$/.test(phone)) {
      setError('phone', '電話番号は数字とハイフンのみで入力してください。');
      ok = false;
    }
    if (!message || message.length > 2000) {
      setError('message', 'ご要望を入力してください（2000文字以内）。');
      ok = false;
    }
    return ok;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !statusEl) return;

    statusEl.textContent = '';
    statusEl.removeAttribute('data-state');

    if (!validate()) {
      statusEl.dataset.state = 'err';
      statusEl.textContent = '入力内容をご確認ください。';
      return;
    }

    const mode = form.dataset.mode;
    const mailto = form.dataset.mailto || '';
    const data = new FormData(form);
    data.delete('company_website');

    if (mode === 'mailto') {
      if (!mailto) {
        statusEl.dataset.state = 'err';
        statusEl.textContent =
          '受付先が未設定です。送信は完了していません。';
        return;
      }
      const subject = encodeURIComponent(
        `【相談】${String(data.get('businessName') || '')}（${String(data.get('area') || '')}）`,
      );
      const body = encodeURIComponent(
        [
          `店舗名: ${data.get('businessName')}`,
          `業種: ${data.get('businessType')}`,
          `興味: ${data.get('interest')}`,
          `所在地: ${data.get('area')}`,
          `担当者: ${data.get('contactName')}`,
          `メール: ${data.get('email')}`,
          `電話: ${data.get('phone') || '（なし）'}`,
          '',
          'ご要望:',
          String(data.get('message') || ''),
        ].join('\n'),
      );
      window.location.href = `mailto:${mailto}?subject=${subject}&body=${body}`;
      statusEl.dataset.state = 'ok';
      statusEl.textContent =
        'メール作成画面を開きました。メーラーで送信するまで受付は完了しません。';
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('submit failed');
      statusEl.dataset.state = 'ok';
      statusEl.textContent = '送信しました。内容を確認のうえご連絡します。';
      form.reset();
    } catch {
      statusEl.dataset.state = 'err';
      statusEl.textContent = '送信に失敗しました。送信は完了していません。時間をおいて再度お試しください。';
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
