# Public site URL (canonical / OG)
PUBLIC_SITE_URL=https://yurei-cyber.github.io/seven-byte

# Subpath for GitHub Pages project site (use / on a root domain / Vercel custom domain)
PUBLIC_BASE_PATH=/seven-byte/

# Contact display (leave empty to hide — do not invent values)
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=

# LINE official account URL — button stays hidden until set
# Example: https://line.me/R/ti/p/@your-id
PUBLIC_LINE_URL=

# Form endpoint (Formspree etc). Provides server-side handling on static hosts.
# If empty, mailto is used when PUBLIC_CONTACT_EMAIL is set; otherwise submit is blocked.
PUBLIC_FORM_ENDPOINT=
