# Public site URL (used in canonical / OG tags)
PUBLIC_SITE_URL=https://example.com

# Contact display (leave empty to hide)
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=

# LINE official account URL — button stays hidden until set
# Example: https://line.me/R/ti/p/@your-id
PUBLIC_LINE_URL=

# Form endpoint (e.g. Formspree https://formspree.io/f/xxxxxx)
# If empty, the quote form uses mailto: with PUBLIC_CONTACT_EMAIL
PUBLIC_FORM_ENDPOINT=
