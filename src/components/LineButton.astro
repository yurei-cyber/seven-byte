---
interface Props {
  href?: string;
  enabled?: boolean;
  label?: string;
  class?: string;
}

const {
  href = '',
  enabled = false,
  label = 'LINEで相談',
  class: className = 'btn btn-line',
} = Astro.props;
---

{
  enabled && href ? (
    <a class={className} href={href} rel="noopener noreferrer" target="_blank">
      {label}
    </a>
  ) : null
}
