---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgencyHeader from '../../components/AgencyHeader.astro';
import AgencyFooter from '../../components/AgencyFooter.astro';
import { processSteps } from '../../config/site';
import { path as p } from '../../config/paths';
---

<BaseLayout
  title="制作の進め方"
  description="Seven Byte への依頼から公開までの4ステップ。"
>
  <AgencyHeader />
  <main id="main">
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h1 style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.5rem);margin:0 0 0.75rem">
            制作の進め方
          </h1>
          <p>確認ポイントを絞った、負担の少ない流れです。</p>
        </div>
        <ol class="steps">
          {
            processSteps.map((step) => (
              <li>
                <h2 style="font-size:1.1rem;margin:0 0 0.35rem">{step.title}</h2>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
        <p style="margin-top:2rem">
          <a class="btn btn-primary" href={p('/contact/')}>無料で相談する</a>
        </p>
      </div>
    </section>
  </main>
  <AgencyFooter />
</BaseLayout>
