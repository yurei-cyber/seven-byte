---
import { path as p } from '../../../config/paths';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkshopHeader from '../../../components/WorkshopHeader.astro';
import WorkshopFooter from '../../../components/WorkshopFooter.astro';
import DemoContactForm from '../../../components/DemoContactForm.astro';
import { demoWorkshop } from '../../../config/site';
---

<BaseLayout
  title={`ご連絡｜${demoWorkshop.name}（デモ）`}
  description="架空整備工場デモのお問い合わせフォーム。実在店舗への連絡ではありません。"
  theme="workshop"
  canonicalPath="/demo/contact/"
>
  <WorkshopHeader />
  <main id="main">
    <section class="section">
      <div class="wrap split" style="align-items:start">
        <div>
          <div class="section-head">
            <h1 style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.6rem);margin:0 0 0.75rem">
              ご連絡（デモ）
            </h1>
            <p>{demoWorkshop.legalNote}</p>
          </div>
          <DemoContactForm />
        </div>
        <aside class="prose">
          <h2>店舗情報（架空）</h2>
          <p>{demoWorkshop.area}</p>
          <p>{demoWorkshop.hours}</p>
          <p>
            電話番号・LINE・実在住所はデモでは掲載していません。本番サイトでは店舗から提供された事実のみを表示します。
          </p>
          <p style="margin-top:1.5rem">
            <a href={p("/")}>Seven Byte のサイトへ戻る</a>
          </p>
        </aside>
      </div>
    </section>
  </main>
  <WorkshopFooter />
</BaseLayout>
