---
import { sevenByte } from '../config/site';
import { path as p } from '../config/paths';

const current = Astro.url.pathname;
const home = p('/');

const links = [
  { href: `${home}#services`, label: 'サービス', match: '#services' },
  { href: `${home}#differences`, label: '選ばれる理由', match: '#differences' },
  { href: `${home}#process`, label: '進め方', match: '#process' },
  { href: `${home}#portfolio`, label: '実績デモ', match: '#portfolio' },
  { href: p('/contact/'), label: 'お問い合わせ', match: '/contact' },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={home} aria-label="Seven Byte ホーム">
      SE<span class="seven">7</span>EN BYTE
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      メニュー
    </button>
    <nav class="nav" id="primary-nav" data-nav aria-label="メイン">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current.includes(link.match) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-primary" href={p('/contact/')}>無料で相談する</a>
      {
        sevenByte.lineEnabled ? (
          <a class="btn btn-line" href={sevenByte.lineUrl} rel="noopener noreferrer" target="_blank">
            LINE
          </a>
        ) : null
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
