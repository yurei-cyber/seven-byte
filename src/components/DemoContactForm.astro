---
/**
 * Demo-only contact form. Does not claim real submissions.
 * Uses the same mailto/endpoint pattern for consistency when configured;
 * otherwise shows validation UX only with a clear demo notice.
 */
import { sevenByte } from '../config/site';

const endpoint = sevenByte.formEndpoint;
const mailto = sevenByte.email;
const mode = sevenByte.formMode;
---

<form
  class="form"
  id="demo-contact-form"
  method="POST"
  action={mode === 'endpoint' ? endpoint : undefined}
  data-mode={mode}
  data-mailto={mailto || ''}
  data-demo="true"
  novalidate
>
  <p class="hint" style="margin:0;padding:0.75rem;background:var(--purple-dim)">
    これは架空デモ用のフォームです。実在の店舗への問い合わせではありません。
  </p>

  <div class="field">
    <label for="demo-name">お名前 <span aria-hidden="true">*</span></label>
    <input id="demo-name" name="name" type="text" required maxlength="40" autocomplete="name" />
    <span class="error" data-error-for="name" role="alert"></span>
  </div>

  <div class="field">
    <label for="demo-email">メールアドレス <span aria-hidden="true">*</span></label>
    <input id="demo-email" name="email" type="email" required maxlength="120" autocomplete="email" />
    <span class="error" data-error-for="email" role="alert"></span>
  </div>

  <div class="field">
    <label for="demo-message">お問い合わせ内容 <span aria-hidden="true">*</span></label>
    <textarea id="demo-message" name="message" required maxlength="1000"></textarea>
    <span class="error" data-error-for="message" role="alert"></span>
  </div>

  <button class="btn btn-primary" type="submit">送信する（デモ）</button>
  <p class="form-status" id="demo-status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('demo-contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('demo-status');

  function setError(name: string, text: string) {
    const el = form?.querySelector(`[data-error-for="${name}"]`);
    if (el) el.textContent = text;
  }

  function clearErrors() {
    form?.querySelectorAll('[data-error-for]').forEach((el) => {
      el.textContent = '';
    });
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !statusEl) return;
    clearErrors();
    statusEl.textContent = '';
    statusEl.removeAttribute('data-state');

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    let ok = true;

    if (!name) {
      setError('name', 'お名前を入力してください。');
      ok = false;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setError('email', '有効なメールアドレスを入力してください。');
      ok = false;
    }
    if (!message) {
      setError('message', 'お問い合わせ内容を入力してください。');
      ok = false;
    }
    if (!ok) {
      statusEl.dataset.state = 'err';
      statusEl.textContent = '入力内容をご確認ください。';
      return;
    }

    const mode = form.dataset.mode;
    const mailto = form.dataset.mailto || '';

    if (mode === 'mailto') {
      if (!mailto) {
        statusEl.dataset.state = 'err';
        statusEl.textContent =
          '入力は有効ですが、受付先未設定のため送信は完了していません（デモ）。';
        return;
      }
      const subject = encodeURIComponent(`【デモ問い合わせ】${name}`);
      const body = encodeURIComponent(`名前: ${name}\nメール: ${email}\n\n${message}`);
      window.location.href = `mailto:${mailto}?subject=${subject}&body=${body}`;
      statusEl.dataset.state = 'ok';
      statusEl.textContent = 'メール作成画面を開きました（デモ）。';
      return;
    }

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('fail');
      statusEl.dataset.state = 'ok';
      statusEl.textContent = '送信しました（デモ経路）。';
      form.reset();
    } catch {
      statusEl.dataset.state = 'err';
      statusEl.textContent = '送信に失敗しました。';
    }
  });
</script>
