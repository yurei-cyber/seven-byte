---
import { demoWorkshop } from '../config/site';
import { path as p } from '../config/paths';

const current = Astro.url.pathname;

const links = [
  { href: p('/demo/'), label: 'ホーム', match: '/demo' },
  { href: p('/demo/services/'), label: 'サービス', match: '/demo/services' },
  { href: p('/demo/contact/'), label: 'ご連絡', match: '/demo/contact' },
];
---

<div class="demo-banner">
  {demoWorkshop.legalNote}
  {' '}
  <a href={p('/')}>Seven Byte のご案内へ</a>
</div>

<header class="site-header">
  <div class="inner">
    <a class="brand" href={p('/demo/')} style="text-transform:none;letter-spacing:0.02em">
      {demoWorkshop.name}
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="workshop-nav"
      data-nav-toggle
    >
      メニュー
    </button>
    <nav class="nav" id="workshop-nav" data-nav aria-label="デモサイト">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              link.match === '/demo'
                ? current.includes('/demo') &&
                  !current.includes('/demo/services') &&
                  !current.includes('/demo/contact')
                  ? 'page'
                  : undefined
                : current.includes(link.match)
                  ? 'page'
                  : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
