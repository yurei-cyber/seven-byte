---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgencyHeader from '../../components/AgencyHeader.astro';
import AgencyFooter from '../../components/AgencyFooter.astro';
import { services } from '../../config/site';
import { path as p } from '../../config/paths';
---

<BaseLayout
  title="初期プラン・サービス範囲"
  description="Seven Byte のホームページ制作・業務システム・保守の参考範囲と価格目安。"
>
  <AgencyHeader />
  <main id="main">
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h1 style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.5rem);margin:0 0 0.75rem">
            初期プラン・サービス範囲
          </h1>
          <p>詳細はトップページのサービス欄にも掲載しています。価格は税別の参考です。</p>
        </div>
        <div class="grid-3">
          {
            services.map((service) => (
              <article class="service-block">
                <h2 style="font-size:1.15rem;margin:0">{service.title}</h2>
                <p class="price">{service.price}</p>
                <p class="price-note">{service.priceNote}</p>
                <ul>
                  {service.scope.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <p style="margin-top:2rem">
          <a class="btn btn-primary" href={p('/contact/')}>相談する</a>
          <a class="btn btn-ghost" href={p('/')} style="margin-left:0.5rem">トップへ</a>
        </p>
      </div>
    </section>
  </main>
  <AgencyFooter />
</BaseLayout>
